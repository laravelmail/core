{
    "name": "laravelmail/core",
    "description": "Embeddable email-marketing engine for Laravel: subscribers, tags, templates, campaigns and suppression, with sending off by default.",
    "type": "library",
    "license": "proprietary",
    "keywords": [
        "laravel",
        "email",
        "campaigns",
        "newsletter"
    ],
    "require": {
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/mail": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "php": "^8.4",
        "symfony/process": "^7.0|^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "orchestra/testbench": "^11.0",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "LaravelMail\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelMail\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelMail\\LaravelMailServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G --no-progress"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "neuron-core/neuron-ai": "AI companion package (laravelmail/ai, later)",
        "webklex/laravel-imap": "Mailbox companion package (later)",
        "aws/aws-sdk-php-laravel": "SES provider",
        "mailgun/mailgun-php": "Mailgun provider"
    }
}
